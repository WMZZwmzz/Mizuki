---
export interface Props {
	text: string | string[];
	speed?: number;
	deleteSpeed?: number;
	pauseTime?: number;
	class?: string;
}

const {
	text,
	speed = 100,
	deleteSpeed = 50,
	pauseTime = 2000,
	class: className = "",
} = Astro.props;
const textData = Array.isArray(text) ? JSON.stringify(text) : text;
const reserveTexts = Array.isArray(text) ? text : [text];
---

<span
	class={`typewriter ${className}`}
	data-text={textData}
	data-speed={speed}
	data-delete-speed={deleteSpeed}
	data-pause-time={pauseTime}
>
	{
		reserveTexts.map((item) => (
			<span class="typewriter__reserve" aria-hidden="true">
				{item || "\u00A0"}
			</span>
		))
	}
	<span class="typewriter__paint" aria-live="polite"></span>
</span>

<script>
	class TypewriterEffect {
		public readonly element: HTMLElement;
		private readonly paint: HTMLElement;
		private readonly texts: string[];
		private currentTextIndex = 0;
		private readonly speed: number;
		private readonly deleteSpeed: number;
		private readonly pauseTime: number;
		private currentIndex = 0;
		private isDeleting = false;
		private timeoutId: number | null = null;
		private running = false;
		private completed = false;

		constructor(element: HTMLElement) {
			this.element = element;
			this.paint =
				element.querySelector<HTMLElement>(".typewriter__paint") ?? element;
			const textData = element.dataset.text || "";

			try {
				const parsed = JSON.parse(textData);
				this.texts = Array.isArray(parsed) ? parsed : [textData];
			} catch {
				this.texts = [textData];
			}

			this.speed = Number.parseInt(element.dataset.speed || "100", 10);
			this.deleteSpeed = Number.parseInt(
				element.dataset.deleteSpeed || "50",
				10,
			);
			this.pauseTime = Number.parseInt(
				element.dataset.pauseTime || "2000",
				10,
			);
		}

		public resume() {
			if (this.running || this.completed || this.texts.length === 0) {
				return;
			}
			this.running = true;
			this.type();
		}

		public pause() {
			this.running = false;
			if (this.timeoutId !== null) {
				window.clearTimeout(this.timeoutId);
				this.timeoutId = null;
			}
		}

		private getCurrentText(): string {
			return this.texts[this.currentTextIndex] || "";
		}

		private schedule(delay: number) {
			this.timeoutId = window.setTimeout(() => this.type(), delay);
		}

		private type() {
			this.timeoutId = null;
			if (!this.running || !this.element.isConnected || document.hidden) {
				this.pause();
				return;
			}

			const currentText = this.getCurrentText();

			if (this.isDeleting) {
				if (this.currentIndex > 0) {
					this.currentIndex--;
					this.paint.textContent = currentText.substring(0, this.currentIndex);
					this.schedule(this.deleteSpeed);
					return;
				}

				this.isDeleting = false;
				this.currentTextIndex =
					(this.currentTextIndex + 1) % this.texts.length;
				this.schedule(this.speed);
				return;
			}

			if (this.currentIndex < currentText.length) {
				this.currentIndex++;
				this.paint.textContent = currentText.substring(0, this.currentIndex);
				this.schedule(this.speed);
				return;
			}

			if (this.texts.length > 1) {
				this.isDeleting = true;
				this.schedule(this.pauseTime);
				return;
			}

			if (currentText === "") {
				this.paint.innerHTML = "&nbsp;";
			}
			this.completed = true;
			this.running = false;
		}

		public destroy() {
			this.pause();
		}
	}

	interface TypewriterManager {
		instances: WeakMap<HTMLElement, TypewriterEffect>;
		tracked: Set<TypewriterEffect>;
		intersectionObserver: IntersectionObserver;
		mutationObserver: MutationObserver;
		reconcile: () => void;
	}

	interface TypewriterWindow extends Window {
		__mizukiTypewriterManager?: TypewriterManager;
	}

	const typewriterWindow = window as TypewriterWindow;

	function isVisible(element: HTMLElement): boolean {
		if (!element.isConnected || document.hidden) {
			return false;
		}

		const style = window.getComputedStyle(element);
		if (style.display === "none" || style.visibility === "hidden") {
			return false;
		}

		const rect = element.getBoundingClientRect();
		return (
			rect.width > 0 &&
			rect.height > 0 &&
			rect.bottom > 0 &&
			rect.right > 0 &&
			rect.top < window.innerHeight &&
			rect.left < window.innerWidth
		);
	}

	function createManager(): TypewriterManager {
		const instances = new WeakMap<HTMLElement, TypewriterEffect>();
		const tracked = new Set<TypewriterEffect>();
		let reconcileFrame = 0;
		let initialize = () => {};

		const reconcile = () => {
			window.cancelAnimationFrame(reconcileFrame);
			reconcileFrame = window.requestAnimationFrame(() => {
				for (const effect of tracked) {
					if (!effect.element.isConnected) {
						effect.destroy();
						intersectionObserver.unobserve(effect.element);
						instances.delete(effect.element);
						tracked.delete(effect);
						continue;
					}

					if (isVisible(effect.element)) {
						effect.resume();
					} else {
						effect.pause();
					}
				}
			});
		};

		const intersectionObserver = new IntersectionObserver(reconcile);
		const mutationObserver = new MutationObserver((records) => {
			const removedTypewriter = records.some((record) =>
				Array.from(record.removedNodes).some(
					(node) =>
						node instanceof HTMLElement &&
						(node.matches(".typewriter") ||
							node.querySelector(".typewriter") !== null),
				),
			);
			const addedTypewriter = records.some((record) =>
				Array.from(record.addedNodes).some(
					(node) =>
						node instanceof HTMLElement &&
						(node.matches(".typewriter") ||
							node.querySelector(".typewriter") !== null),
				),
			);
			if (removedTypewriter) {
				reconcile();
			}
			if (addedTypewriter) {
				initialize();
			}
		});

		const manager: TypewriterManager = {
			instances,
			tracked,
			intersectionObserver,
			mutationObserver,
			reconcile,
		};

		initialize = () => {
			if (document.body) {
				mutationObserver.observe(document.body, {
					childList: true,
					subtree: true,
				});
			}
			document.querySelectorAll<HTMLElement>(".typewriter").forEach((element) => {
				if (instances.has(element)) {
					return;
				}

				const effect = new TypewriterEffect(element);
				instances.set(element, effect);
				tracked.add(effect);
				intersectionObserver.observe(element);
			});
			reconcile();
		};

		window.addEventListener("resize", reconcile, { passive: true });
		document.addEventListener("visibilitychange", reconcile);
		document.addEventListener("astro:page-load", initialize);
		document.addEventListener("swup:contentReplaced", initialize);

		if (document.readyState === "loading") {
			document.addEventListener("DOMContentLoaded", initialize, { once: true });
		} else {
			initialize();
		}

		return manager;
	}

	if (typewriterWindow.__mizukiTypewriterManager) {
		typewriterWindow.__mizukiTypewriterManager.reconcile();
	} else {
		typewriterWindow.__mizukiTypewriterManager = createManager();
	}
</script>

<style>
	.typewriter {
		position: relative;
		display: inline-grid;
		min-height: 1.5em;
		vertical-align: baseline;
	}

	.typewriter__reserve {
		visibility: hidden;
		grid-area: 1 / 1;
		pointer-events: none;
	}

	.typewriter__paint {
		position: absolute;
		inset: 0;
		contain: strict;
	}
</style>
